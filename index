      if (dateEl) dateEl.textContent = formatted;
      var yearEl = document.getElementById('footer-year');
      if (yearEl) yearEl.textContent = d.getFullYear();
    }catch(e){ /* keep static fallback already in the HTML */ }
  }

  /* ======================================================================
   * Reading time, computed from the article body word count
   * ==================================================================== */
  function setReadTime(){
    var body = document.querySelector('.article-body');
    var el = document.getElementById('read-time');
    if (!body || !el) return;
    var words = body.textContent.trim().split(/\s+/).length;
    var minutes = Math.max(1, Math.round(words / 200));
    el.textContent = minutes + ' min read';
  }

  /* ======================================================================
   * Sticky mobile CTA — appears after 40% scroll depth, mobile only
   * ==================================================================== */
  function initStickyCta(){
    var bar = document.getElementById('stickyCta');
    var closeBtn = document.getElementById('stickyCtaClose');
    if (!bar) return;

    var dismissed = false;
    var isMobile = function(){ return window.matchMedia('(max-width: 767px)').matches; };

    function scrollPercent(){
      var doc = document.documentElement;
      var scrollTop = doc.scrollTop || document.body.scrollTop;
      var scrollHeight = (doc.scrollHeight || document.body.scrollHeight) - doc.clientHeight;
      if (scrollHeight <= 0) return 0;
      return (scrollTop / scrollHeight) * 100;
    }

    var ticking = false;
    var scrolledHalf = false;
    var scrolledMost = false;

    function onScroll(){
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function(){
        var pct = scrollPercent();

        if (!dismissed && isMobile() && pct >= 40){
          bar.classList.add('is-visible');
        }

        if (!scrolledHalf && pct >= 50){
          scrolledHalf = true;
          fireEvent('scroll_50');
        }
        if (!scrolledMost && pct >= 90){
          scrolledMost = true;
          fireEvent('scroll_90');
        }
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    if (closeBtn){
      closeBtn.addEventListener('click', function(){
        dismissed = true;
        bar.classList.remove('is-visible');
      });
    }
  }

  /* ======================================================================
   * (Optional) Subtle desktop exit-intent: gently highlight the final CTA.
   * No popup — just a brief visual pulse, once per session.
   * ==================================================================== */
  function initExitIntent(){
    if (window.matchMedia('(max-width: 767px)').matches) return;
    var finalCta = document.querySelector('.final-cta .cta-final-btn');
    if (!finalCta) return;
    var triggered = false;

    document.addEventListener('mouseout', function(e){
      if (triggered) return;
      if (e.clientY > 8) return;
      triggered = true;
      finalCta.style.transition = 'transform .2s ease, box-shadow .2s ease';
      finalCta.style.boxShadow = '0 0 0 4px rgba(122,31,43,0.18)';
      finalCta.style.transform = 'scale(1.04)';
      window.setTimeout(function(){
        finalCta.style.boxShadow = '';
        finalCta.style.transform = '';
      }, 1600);
    });
  }

  /* ======================================================================
   * Init
   * ==================================================================== */
  document.addEventListener('DOMContentLoaded', function(){
    wireUpCtas();
    setDynamicDate();
    setReadTime();
    initStickyCta();
    initExitIntent();
    fireEvent('page_view');
  });
})();
</script>

